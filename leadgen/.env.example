# DataForSEO account credentials (https://app.dataforseo.com)
# Login = the email you signed up with. Password = the API password shown
# on your dashboard, NOT your account login password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Main site — used for absolute links back from a report page (booking,
# service pages, favicon). This is the primary-domain Worker.
SITE_BASE_URL=https://universeaiconsulting.com

# Where reports/ itself is deployed — the reports-worker/ Worker, on its
# own subdomain, isolated from the main site's crawl/SEO/email footprint.
# Pick the actual subdomain you attach as a Custom Domain to that worker.
REPORTS_BASE_URL=https://rank.universeaiconsulting.com

# Shared secret between this pipeline and the main site's /api/leadgen-notify
# endpoint (sends the "new target ready" email). Generate any random string;
# set the identical value on the Worker with:
#   npx wrangler secret put LEADGEN_NOTIFY_SECRET
LEADGEN_NOTIFY_SECRET=
